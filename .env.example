# Flask Environment Configuration
# For local development: uncomment and set values
# For production (Render): Use Render's environment variable settings

# FLASK_ENV: Set to 'development' for debug mode, omit or set to 'production' for production
FLASK_ENV=development

# SECRET_KEY: Set a secure random key in production
# In Render: Use the Render dashboard to set this environment variable securely
SECRET_KEY=your-secret-key-change-in-production

# PORT: Usually handled by Render automatically
# For local testing, you can override it here
# PORT=5000

# Flask Environment Configuration
# Copy this file to .env and update values before running locally.
# For production deployments, use platform environment variables instead of committing secrets.

# FLASK_ENV: Use 'development' for local testing, 'production' for production.
FLASK_ENV=production

# SECRET_KEY: Set a secure random key in production.
SECRET_KEY=replace-with-a-secure-random-value

# PORT: Usually handled by production hosts. Override only for local testing.
PORT=5000

# Production security settings
SESSION_COOKIE_SECURE=true
PREFERRED_URL_SCHEME=https
ENABLE_PROXY_FIX=true
